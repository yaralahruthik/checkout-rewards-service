{
  "openapi": "3.1.0",
  "info": {
    "title": "Checkout and Rewards API",
    "version": "0.1.0",
    "description": "Carts, idempotent checkout, and milestone coupons. All money is in integer cents (USD)."
  },
  "paths": {
    "/api/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "products.listProducts",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Every product with its current unit price and available inventory.",
        "summary": "List products"
      }
    },
    "/api/admin/products/{id}": {
      "patch": {
        "tags": [
          "Admin: products"
        ],
        "operationId": "adminProducts.updateProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/ProductIdEncoded"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No product has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "Sets the unit price and/or the available inventory. Both are absolute values, not deltas.",
        "summary": "Update a product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationErrorEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "enum": [
                  "path",
                  "query",
                  "headers",
                  "body"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "location",
              "issues"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "ProductNotFoundEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PRODUCT_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "productId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ProductId"
          },
          "name": {
            "type": "string"
          },
          "unitPriceCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "availableInventory": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "unitPriceCents",
          "availableInventory"
        ],
        "additionalProperties": false
      },
      "Cents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "An amount of money in integer cents (USD)."
      },
      "ProductId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "ProductIdEncoded": {
        "type": "string",
        "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "unitPriceCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "availableInventory": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "Products"
    },
    {
      "name": "Admin: products"
    }
  ]
}
