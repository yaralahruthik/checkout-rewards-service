{
  "openapi": "3.1.0",
  "info": {
    "title": "Checkout and Rewards API",
    "version": "0.1.0",
    "description": "Carts, idempotent checkout, and milestone coupons. All money is in integer cents (USD)."
  },
  "paths": {
    "/api/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "products.listProducts",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Every product with its current unit price and available inventory.",
        "summary": "List products"
      }
    },
    "/api/carts": {
      "post": {
        "tags": [
          "Carts"
        ],
        "operationId": "carts.createCart",
        "parameters": [],
        "security": [],
        "responses": {
          "201": {
            "description": "The cart priced at current product prices. Totals change when prices change; nothing is reserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Creates an empty open cart. Keep its id: it is the only way to reach the cart.",
        "summary": "Create a cart"
      }
    },
    "/api/carts/{id}": {
      "get": {
        "tags": [
          "Carts"
        ],
        "operationId": "carts.getCart",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/CartId"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The cart priced at current product prices. Totals change when prices change; nothing is reserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart_1"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No cart has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "Each line with its live unit price, line total and available inventory, plus the subtotal.",
        "summary": "Get a cart"
      }
    },
    "/api/carts/{id}/items/{productId}": {
      "put": {
        "tags": [
          "Carts"
        ],
        "operationId": "carts.setItemQuantity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/CartId"
            },
            "required": true
          },
          {
            "name": "productId",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/ProductIdEncoded"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The cart priced at current product prices. Totals change when prices change; nothing is reserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart_1"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No cart has the given id. | No product has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CartNotFoundEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/ProductNotFoundEncoded"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "The cart is checked out, so its lines cannot change. | A requested quantity exceeds the product's available inventory.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CartNotOpenEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/InsufficientInventoryEncoded"
                    }
                  ]
                }
              }
            }
          }
        },
        "description": "Creates the line or replaces its quantity. Never adds to the existing quantity, so retrying is safe. The quantity is checked against current inventory, but nothing is reserved: checkout checks again.",
        "summary": "Set an item's quantity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetQuantity"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "tags": [
          "Carts"
        ],
        "operationId": "carts.removeItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/CartId"
            },
            "required": true
          },
          {
            "name": "productId",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/ProductIdEncoded"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The cart priced at current product prices. Totals change when prices change; nothing is reserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart_1"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No cart has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartNotFoundEncoded"
                }
              }
            }
          },
          "409": {
            "description": "The cart is checked out, so its lines cannot change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartNotOpenEncoded"
                }
              }
            }
          }
        },
        "description": "Deletes the product's line. Removing a product that is not in the cart changes nothing, so retrying is safe.",
        "summary": "Remove an item"
      }
    },
    "/api/carts/{id}/checkout": {
      "post": {
        "tags": [
          "Checkout"
        ],
        "operationId": "checkout.checkout",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/CartId"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "A placed order. Its lines and totals never change after checkout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order_1"
                }
              }
            }
          },
          "201": {
            "description": "A placed order. Its lines and totals never change after checkout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No cart has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartNotFoundEncoded"
                }
              }
            }
          },
          "409": {
            "description": "The cart was already checked out; `orderId` is the order it produced. | The current subtotal differs from `expectedSubtotalCents`. Nothing changed: the cart is still open. Confirm the new totals and check out again with the new subtotal. | A requested quantity exceeds the product's available inventory.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CartAlreadyCheckedOutEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/PriceChangedEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/InsufficientInventoryEncoded"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "The cart has no lines, so there is nothing to order. | No coupon has the given code.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/EmptyCartEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/CouponInvalidEncoded"
                    }
                  ]
                }
              }
            }
          }
        },
        "description": "In one transaction: closes the cart, prices its lines at current prices, takes the stock, and records the order with snapshots of every line. If any step fails, nothing changes: the cart stays open and stock is untouched.",
        "summary": "Check out a cart",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CheckoutRequest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "orders.getOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/OrderId"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "A placed order. Its lines and totals never change after checkout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order_1"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No order has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "The order with its line snapshots and how its total was calculated.",
        "summary": "Get an order"
      }
    },
    "/api/admin/products/{id}": {
      "patch": {
        "tags": [
          "Admin: products"
        ],
        "operationId": "adminProducts.updateProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/ProductIdEncoded"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "404": {
            "description": "No product has the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductNotFoundEncoded"
                }
              }
            }
          }
        },
        "description": "Sets the unit price and/or the available inventory. Both are absolute values, not deltas.",
        "summary": "Update a product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/admin/coupons/generate": {
      "post": {
        "tags": [
          "Admin: coupons"
        ],
        "operationId": "adminCoupons.generateCoupon",
        "parameters": [],
        "security": [],
        "responses": {
          "201": {
            "description": "A bearer coupon: anyone holding the code can redeem it once. It never expires, and its percent never changes after generation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coupon"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "409": {
            "description": "Every milestone reached so far already has its coupon. `nextMilestoneOrderCount` is the order count at which the next one becomes available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoEligibleMilestoneEncoded"
                }
              }
            }
          }
        },
        "description": "Issues one coupon for the oldest milestone that has been reached but not rewarded. Every n-th successful order is a milestone. Safe to repeat and to call concurrently: each milestone gets exactly one coupon, and every other request is refused.",
        "summary": "Generate a coupon"
      }
    },
    "/api/admin/coupons": {
      "get": {
        "tags": [
          "Admin: coupons"
        ],
        "operationId": "adminCoupons.listCoupons",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Coupon_1"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the endpoint's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Every coupon with its status, newest milestone first.",
        "summary": "List coupons"
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationErrorEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "enum": [
                  "path",
                  "query",
                  "headers",
                  "body"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "location",
              "issues"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Coupon_1": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CouponCode"
          },
          "milestoneOrderCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "discountPercent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "$ref": "#/components/schemas/CouponStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "When the coupon was generated (ISO 8601, UTC)."
          },
          "redeemedOrderId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderId"
              },
              {
                "type": "null"
              }
            ]
          },
          "redeemedAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "When the coupon was redeemed (ISO 8601, UTC)."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "milestoneOrderCount",
          "discountPercent",
          "status",
          "createdAt",
          "redeemedOrderId",
          "redeemedAt"
        ],
        "additionalProperties": false,
        "description": "A bearer coupon: anyone holding the code can redeem it once. It never expires, and its percent never changes after generation."
      },
      "OrderId": {
        "type": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
        "format": "uuid",
        "description": "A UUIDv7."
      },
      "CouponStatus": {
        "type": "string",
        "enum": [
          "AVAILABLE",
          "REDEEMED"
        ]
      },
      "CouponCode": {
        "type": "string",
        "description": "`SAVE<x>-` followed by 8 Crockford base32 characters, for example `SAVE10-7KQ2M9XA`."
      },
      "NoEligibleMilestoneEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "NO_ELIGIBLE_MILESTONE"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "orderCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "nextMilestoneOrderCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "orderCount",
              "nextMilestoneOrderCount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Coupon": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CouponCode"
          },
          "milestoneOrderCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "discountPercent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "$ref": "#/components/schemas/CouponStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "When the coupon was generated (ISO 8601, UTC)."
          },
          "redeemedOrderId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderId"
              },
              {
                "type": "null"
              }
            ]
          },
          "redeemedAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "When the coupon was redeemed (ISO 8601, UTC)."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "milestoneOrderCount",
          "discountPercent",
          "status",
          "createdAt",
          "redeemedOrderId",
          "redeemedAt"
        ],
        "additionalProperties": false,
        "description": "A bearer coupon: anyone holding the code can redeem it once. It never expires, and its percent never changes after generation."
      },
      "ProductNotFoundEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PRODUCT_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "productId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ProductId"
          },
          "name": {
            "type": "string"
          },
          "unitPriceCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "availableInventory": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "unitPriceCents",
          "availableInventory"
        ],
        "additionalProperties": false
      },
      "Cents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "An amount of money in integer cents (USD)."
      },
      "ProductId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "ProductIdEncoded": {
        "type": "string",
        "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "unitPriceCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "availableInventory": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "OrderNotFoundEncoded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ORDER_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string"
              }
            },
            "required": [
              "orderId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Order_1": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OrderId"
          },
          "subtotalCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "discountCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "totalCents": {
            "$ref": "#/components/schemas/Cents"
          },
          "createdAt": {
            "type": "string",
            "description": "When the order was placed (ISO 8601, UTC)."
          },
          "lines": {
