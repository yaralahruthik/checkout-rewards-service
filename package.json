{
  "name": "uniblox-checkout",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "generate": "vp run --filter @uniblox/web generate",
    "check": "vp run generate && vp check",
    "test": "vp test",
    "build": "vp run -r build",
    "openapi": "vp run --filter @uniblox/api openapi",
    "db:reset": "vp run --filter @uniblox/api db:reset"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@uniblox/tsconfig": "workspace:*",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0"
}
